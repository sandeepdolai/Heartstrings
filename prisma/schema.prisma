generator client {
  provider = "prisma-client-js"
  // queryCompiler = pure-JS/WASM query engine (no native Rust binary —
  // required to run on Cloudflare Workers); driverAdapters = D1 locally
  // emulated via better-sqlite3, PrismaD1 on the deployment.
  previewFeatures = ["queryCompiler", "driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  // Null for OAuth-only accounts (e.g. Google) — they have no password.
  passwordHash String?
  // Google account identifier ("sub" claim) — set on first Google sign-in,
  // lets us re-link returning Google users even if they change email.
  googleId     String?   @unique
  // Profile picture URL (Google avatar, when available).
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  projects     Project[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  data          String
  coverImage    String?
  shareToken    String?     @unique
  publishedData String?
  publishedAt   DateTime?
  // Denormalized canvas count so list views never parse multi-MB `data`.
  // null on legacy rows → toSummary falls back to parsing inline `data`.
  pageCount     Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  blobs         BlobRef[]
  publishSessions PublishSession[]
}

// Large text payloads (project JSON, published books, staged publish pages)
// are stored as ordered chunks. Cloudflare D1 rejects bound parameters
// above ~8–10MB (SQLITE_TOOBIG), so big values split into ≤3.5MB pieces; a
// column holds either the inline value (small strings) or the marker
// "psblob:<id>" pointing at the chunks below. Identical behaviour locally.
model BlobRef {
  id        String      @id
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purpose   String
  createdAt DateTime    @default(now())
  chunks    BlobChunk[]

  @@index([projectId])
}

model BlobChunk {
  blobId String
  idx    Int
  data   String
  blob   BlobRef @relation(fields: [blobId], references: [id], onDelete: Cascade)

  @@id([blobId, idx])
}

// Staging for chunked publishing. Persisted (not in-memory) so it survives
// across isolates on Cloudflare Workers; swept by TTL on every call.
model PublishSession {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  pageCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}
